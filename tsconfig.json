{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@voucherguard/core": ["packages/core/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "apps/web/src",
    "apps/web/vite.config.ts",
    "tests",
    "scripts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
