# Set this only once the actual cg1290-tech repository has been created.
VITE_REPOSITORY_URL=https://github.com/cg1290-tech/voucherguard
# Optional. Default './' works under static project subpaths.
VITE_BASE_PATH=/voucherguard/

# Optional public RPC URL for Quick Check / browser reads (not the Pro access gate).
# These values are visible in the browser bundle. Never put secrets here.
# Holder mint/threshold/session secret belong in Cloudflare Pages secrets — see docs/pro.md.
VITE_VG_RPC_URL=https://voucherguard.pages.dev/api/solana-rpc

# Robinhood Pro configuration lives in Pages Worker secrets, not VITE variables:
# VG_ACCESS_CHAIN=robinhood
# VG_TOKEN_CONTRACT=<official ERC-20 contract, unset before launch>
# VG_HOLDER_THRESHOLD=1
# PRO_SESSION_SECRET=<server-only random secret>
# WALLETCONNECT_PROJECT_ID=<public Reown project identifier>
# RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
